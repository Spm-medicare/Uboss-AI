# Copy to .env.local. Everything with a NEXT_PUBLIC_ prefix is compiled into the JavaScript the
# browser downloads, so a secret must never be given one of these names.

#  Relative on purpose: the browser calls whichever host served the page, and Next
#  forwards it to UBOSS_API_ORIGIN. An absolute localhost here is wrong for every
#  browser that is not on this machine — a tunnel, a phone, a colleague's laptop.
NEXT_PUBLIC_API_BASE_URL=/api/v1

#  Where this Next server dials the API. Server-side only, so it stays out of the bundle.
UBOSS_API_ORIGIN=http://localhost:8001
