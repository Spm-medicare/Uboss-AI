# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
# Every name is prefixed UBOSS_ so a stray variable from another tool on the same machine cannot
# change this application's behaviour.

UBOSS_ENVIRONMENT=local
UBOSS_LOG_LEVEL=info
UBOSS_PUBLIC_BASE_URL=http://localhost:3000

# The application role. Not the owner: row-level security only holds if the role that serves
# requests cannot switch it off.
UBOSS_DATABASE_URL=postgresql+psycopg://uboss_app:uboss_app@localhost:5433/uboss

# The owner role, used only by Alembic. Creates tables and RLS policies.
UBOSS_MIGRATION_DATABASE_URL=postgresql+psycopg://uboss_owner:uboss_owner@localhost:5433/uboss

# The outbox relay. The ONLY credential in this system that reads across every tenant, and its
# reach is SELECT and UPDATE on outbox_events alone. A migration cannot create this role — that
# is deliberate, see migration 0008.
UBOSS_RELAY_DATABASE_URL=postgresql+psycopg://uboss_relay:uboss_relay@localhost:5433/uboss

UBOSS_REDIS_URL=redis://localhost:6380/0

# Authentication abuse controls. Defaults are suitable for the controlled pilot; production
# values are reviewed with Security using observed traffic, never disabled for convenience.
UBOSS_WORKSPACE_CHALLENGE_SECONDS=180
UBOSS_SESSION_IDLE_MINUTES=480
UBOSS_SESSION_ROTATION_MINUTES=60
UBOSS_SESSION_ROTATION_GRACE_SECONDS=120
UBOSS_STEP_UP_MINUTES=15
UBOSS_STEP_UP_IP_LIMIT=20
UBOSS_STEP_UP_MEMBERSHIP_LIMIT=5
UBOSS_STEP_UP_WINDOW_SECONDS=300
UBOSS_INVITE_TOKEN_MINUTES=1440
UBOSS_PASSWORD_RESET_TOKEN_MINUTES=30
UBOSS_SIGN_IN_IP_LIMIT=30
UBOSS_SIGN_IN_IP_WINDOW_SECONDS=300
UBOSS_SIGN_IN_ACCOUNT_LIMIT=10
UBOSS_SIGN_IN_ACCOUNT_WINDOW_SECONDS=900
UBOSS_SIGN_IN_PAIR_LIMIT=8
UBOSS_SIGN_IN_PAIR_WINDOW_SECONDS=300

# Signs session tokens. Generate a fresh one per environment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating this signs everyone out, which is the intended behaviour after a suspected leak.
UBOSS_AUTH_SIGNING_KEY=

# Leave empty until a key is issued. Empty is a supported state: the product says on screen that
# no model is reachable and falls back to its deterministic rules. It never pretends otherwise.
UBOSS_ANTHROPIC_API_KEY=

# Object storage. Empty keys mean files are unavailable, which the product says on screen
# rather than accepting an upload it cannot keep.
UBOSS_S3_ENDPOINT_URL=http://localhost:9002
UBOSS_S3_BUCKET=uboss-files
UBOSS_S3_ACCESS_KEY=uboss_minio
UBOSS_S3_SECRET_KEY=uboss_minio_dev_only

UBOSS_TEMPORAL_ADDRESS=localhost:7233
UBOSS_TEMPORAL_NAMESPACE=default

# Where traces go. Empty means they are created and discarded, which is a supported state —
# the same code path runs either way.
UBOSS_OTLP_ENDPOINT=

UBOSS_TRUSTED_HOSTS=localhost,127.0.0.1
UBOSS_CORS_ORIGINS=http://localhost:3000

# Outbound mail. Empty is a supported state: the recovery screen says the deployment cannot send
# mail rather than claiming a link was sent. 465 uses implicit TLS; anything else gets STARTTLS,
# and the sender refuses to fall back to a plaintext connection either way.
UBOSS_SMTP_HOST=smtp.gmail.com
UBOSS_SMTP_PORT=587
UBOSS_SMTP_USERNAME=
UBOSS_SMTP_PASSWORD=
# Defaults to the SMTP username. Set only when the account may send as another address.
UBOSS_MAIL_FROM_ADDRESS=
UBOSS_MAIL_FROM_NAME=UBOSS AI

# Federated sign-in. A provider needs BOTH an id and a secret to appear on the sign-in screen —
# a button that cannot complete a sign-in is a control that does not do what it says.
UBOSS_GOOGLE_CLIENT_ID=
UBOSS_GOOGLE_CLIENT_SECRET=
UBOSS_MICROSOFT_CLIENT_ID=
UBOSS_MICROSOFT_CLIENT_SECRET=
UBOSS_MICROSOFT_TENANT=common
UBOSS_APPLE_CLIENT_ID=
UBOSS_APPLE_CLIENT_SECRET=

# Which provider answers. `auto` prefers Anthropic when both keys are set; naming one explicitly
# is honoured even if its key is missing, so a misconfiguration says "no model is configured"
# rather than silently using the other provider.
UBOSS_AI_PROVIDER=auto
UBOSS_OPENAI_API_KEY=
UBOSS_OPENAI_BASE_URL=https://api.openai.com
UBOSS_OPENAI_MODEL_COLUMN_MAPPING=gpt-4.1-mini
UBOSS_OPENAI_MODEL_PROPOSAL=gpt-4.1
