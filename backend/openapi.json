{
  "components": {
    "schemas": {
      "ChooseWorkspaceResponse": {
        "description": "The password was right, but the person belongs to more than one organisation.\n\nReturned with 200, not an error: nothing failed. The client shows a chooser and submits the\nshort-lived challenge \u2014 never the password again. The list is only ever produced after a\ncorrect password.",
        "properties": {
          "challenge": {
            "description": "Short-lived, single-use workspace selection proof.",
            "title": "Challenge",
            "type": "string"
          },
          "status": {
            "const": "choose_workspace",
            "default": "choose_workspace",
            "title": "Status",
            "type": "string"
          },
          "workspaces": {
            "items": {
              "$ref": "#/components/schemas/WorkspaceSummary"
            },
            "title": "Workspaces",
            "type": "array"
          }
        },
        "required": [
          "challenge",
          "workspaces"
        ],
        "title": "ChooseWorkspaceResponse",
        "type": "object"
      },
      "CurrentUser": {
        "description": "Who is signed in, and what they may do.\n\n`actions` drives menu visibility. It is a convenience for the interface and never a\nsubstitute for the check: every route re-resolves permissions server-side, because a list\nsent to a browser is a list the browser can edit.",
        "properties": {
          "actions": {
            "items": {
              "type": "string"
            },
            "title": "Actions",
            "type": "array"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "job_title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Job Title"
          },
          "membership_id": {
            "format": "uuid",
            "title": "Membership Id",
            "type": "string"
          },
          "org_node_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Org Node Id"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "title": "Roles",
            "type": "array"
          },
          "session_expires_at": {
            "format": "date-time",
            "title": "Session Expires At",
            "type": "string"
          },
          "stepped_up": {
            "default": false,
            "title": "Stepped Up",
            "type": "boolean"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          },
          "workspace_name": {
            "title": "Workspace Name",
            "type": "string"
          },
          "workspace_slug": {
            "title": "Workspace Slug",
            "type": "string"
          }
        },
        "required": [
          "membership_id",
          "display_name",
          "email",
          "roles",
          "actions",
          "workspace_slug",
          "workspace_name",
          "timezone",
          "session_expires_at"
        ],
        "title": "CurrentUser",
        "type": "object"
      },
      "DependencyStatus": {
        "properties": {
          "detail": {
            "default": "",
            "title": "Detail",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "ok": {
