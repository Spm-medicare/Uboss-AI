                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/SignInResponse"
                    },
                    {
                      "$ref": "#/components/schemas/ChooseWorkspaceResponse"
                    }
                  ],
                  "title": "Response Sign In Api V1 Auth Sign In Post"
                }
              }
            },
            "description": "Signed in, or asked to choose a workspace."
          },
          "401": {
            "description": "The credentials did not match an account."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Refused. The reason is in the audit trail."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "No such record, for this caller."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The record moved, or the key was reused."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Some field was not accepted."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Too many attempts. See Retry-After."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "A fault on our side. Nothing was changed."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
