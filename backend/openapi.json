            "const": "password",
            "default": "password",
            "title": "Method",
            "type": "string"
          },
          "status": {
            "const": "stepped_up",
            "default": "stepped_up",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "expires_at"
        ],
        "title": "StepUpResponse",
        "type": "object"
      },
      "WorkspaceSelectionRequest": {
        "additionalProperties": false,
        "properties": {
          "challenge": {
            "maxLength": 200,
            "minLength": 32,
            "title": "Challenge",
            "type": "string"
          },
          "workspace": {
            "maxLength": 63,
            "minLength": 1,
            "title": "Workspace",
            "type": "string"
          }
        },
        "required": [
          "challenge",
          "workspace"
        ],
        "title": "WorkspaceSelectionRequest",
        "type": "object"
      },
      "WorkspaceSummary": {
        "description": "One organisation this person belongs to.",
        "properties": {
          "display_name": {
            "description": "Their name as this organisation knows them.",
            "title": "Display Name",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          }
        },
        "required": [
          "slug",
          "name",
          "display_name"
        ],
        "title": "WorkspaceSummary",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "Governed human and AI work operating system",
    "title": "UBOSS AI",
    "version": "0.1.0"
  },
