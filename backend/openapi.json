    "/api/v1/auth/sessions": {
      "get": {
        "description": "Every live session for this person, in this workspace.\n\nScoped to the caller's own `user_id` as well as the tenant. An administrator ending someone\nelse's session is a separate, audited action \u2014 not a side effect of viewing a list.",
        "operationId": "list_sessions_api_v1_auth_sessions_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SessionSummary"
                  },
                  "title": "Response List Sessions Api V1 Auth Sessions Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not signed in, or the session ended."
